# coderag environment variables. Copy to .env (gitignored) and fill in what you use.
# Never commit real keys.

# --- LLM selection (CLI `ask`, `make eval`, and the API's server-side fallback) ---
CODERAG_PROVIDER=            # anthropic | openai | gemini | groq | together | openrouter | ollama | openai_compatible (empty = legacy Anthropic path)
CODERAG_MODEL=               # model id for the chosen provider, e.g. claude-opus-5-5
CODERAG_BASE_URL=            # only for CODERAG_PROVIDER=openai_compatible (https, public host)
CODERAG_LLM_KEY=             # generic key; takes precedence over the provider-specific variables below
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# --- Outbound request policy (SSRF guard) ---
CODERAG_ALLOW_INSECURE_LOCAL=   # 1 = allow http://localhost (Ollama) for local development only
CODERAG_PROVIDER_HOSTS=         # optional comma-separated allowlist of hosts for custom base URLs

# --- API server ---
CODERAG_ALLOWED_ROOTS=       # os.pathsep-separated directories whose repos may be indexed
CODERAG_DB_DIR=.coderag      # where per-repo index databases live
CODERAG_API_TOKEN=           # if set, /index and /ask require "Authorization: Bearer <token>"
CODERAG_BYO_LLM_ONLY=        # 1 = /ask requires X-LLM-* headers; never uses a server key
CODERAG_REQUIRE_HTTPS=       # 1 = reject plain-HTTP requests (except /health)
CODERAG_TRUST_PROXY=         # 1 = trust X-Forwarded-Proto / X-Forwarded-For from your proxy
CODERAG_RATE_ASK_PER_MIN=30
CODERAG_RATE_INDEX_PER_MIN=10
CODERAG_MAX_BODY_BYTES=64000
CODERAG_MAX_STEPS=12
CODERAG_MAX_REPO_FILES=5000
CODERAG_MAX_REPO_BYTES=50000000
CODERAG_INDEX_CONCURRENCY=2

# --- Web app ---
CODERAG_HOSTED=              # 1 = public deployment: bundled repo only, keys only from what visitors type

# --- Embeddings and evaluation (need: pip install -e '.[embed]') ---
CODERAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
CODERAG_MODEL_DIR=           # default: data/models
CODERAG_PRICE_IN=            # USD per million input tokens, for cost estimates in make eval
CODERAG_PRICE_OUT=           # USD per million output tokens
HF_HUB_OFFLINE=1             # the embedding model is never downloaded at runtime

# --- Live tests (pytest -m live) ---
# The frozen tests/conftest.py skips every live test unless ANTHROPIC_API_KEY is set,
# so set it (any non-empty value works for non-Anthropic tests) plus a provider pair:
CODERAG_LIVE_ANTHROPIC_MODEL=
CODERAG_LIVE_OPENAI_MODEL=
CODERAG_LIVE_GEMINI_MODEL=
CODERAG_LIVE_GROQ_MODEL=
CODERAG_LIVE_TOGETHER_MODEL=
CODERAG_LIVE_OPENROUTER_MODEL=
